GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=replace-with-provider-key
GROQ_MODEL=llama-3.3-70b-versatile

# Local/Supabase can use JDBC URLs. Render Postgres can use its native
# postgresql://user:password@host:port/database connection string.
DATABASE_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
FLYWAY_BASELINE_ON_MIGRATE=false

APP_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://snbnzkura.vercel.app/
APP_FRONTEND_URL=https://snbnzkura.vercel.app/
AUTH_JWT_ISSUER=spring-ai-rag-orchestrator
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long
AUTH_TOKEN_TTL=PT2H

AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Render production values:
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=None


SUPABASE_S3_ENDPOINT=replace-with-supabase-s3-endpoint
SUPABASE_S3_REGION=replace-with-supabase-s3-region
SUPABASE_S3_ACCESS_KEY_ID=replace-with-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
SUPABASE_S3_BUCKET_NAME=replace-with-s3-bucket-name

